# LunchDrop — PRODUCTION env namunasi.
# Serverda nusxa oling:  cp .env.prod.example .env.prod  va qiymatlarni to'ldiring.
# .env.prod git'ga TUSHMAYDI (maxfiy).

# --- Application ---
APP_NAME=LunchDrop
ENV=production
DEBUG=false

# --- App DB ulanishi (Postgres serverda native o'rnatilgan) ---
# HOST = localhost (Postgres shu serverda). Parolni o'zingiz qo'ygan parol bilan moslang.
DATABASE_URL=postgresql+asyncpg://lunchdrop:CHANGE_ME_kuchli_parol@localhost:5432/lunchdrop

# --- JWT (RS256) — auth qo'shilganda kerak bo'ladi ---
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS — frontend/admin domenlari (vergul bilan) ---
# Domen yo'q bo'lsa, brauzer frontendi qaysi origin'dan kelsa shuni yozing.
CORS_ORIGINS=http://localhost:3000

# --- Telegram bot — SMS yo'q bo'lsa OTP shu bot orqali admin'larga yuboriladi ---
BOT_TOKEN=
OTP_NOTIFY_CHAT_IDS=961047307,1038185913
# Super Admin va Company Adminlar /start orqali o'z telefonini bog'laydi.
# OTP_NOTIFY_CHAT_IDS Super Admin uchun boshlang'ich/fallback xabar oluvchilar hamdir.

# --- Biznes logika ---
TIMEZONE=Asia/Tashkent
BATCHING_MIN_ORDERS_PER_GROUP=1

# --- Server sozlamalari ---
API_PORT=8000          # host porti (http://SERVER_IP:8000)
WEB_CONCURRENCY=2      # uvicorn worker soni (CPU yadrolariga qarab)
