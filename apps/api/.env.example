# LunchDrop backend — environment namunasi.
# Nusxa olib `.env` yarating:  cp .env.example .env
# .env hech qachon git'ga tushmaydi (maxfiy qiymatlar shu yerda).

# --- Application ---
APP_NAME=LunchDrop
ENV=development              # development | production
DEBUG=true

# --- Database (PostgreSQL async) ---
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DB
# Lokal Postgres container'ni ko'tarish:
#   docker run -d --name lunchdrop \
#     -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=admin1234 -e POSTGRES_DB=lunchdrop \
#     -p 5432:5432 postgres:16
DATABASE_URL=postgresql+asyncpg://postgres:admin1234@localhost:5432/lunchdrop

# --- JWT (RS256) ---
# Kalitlarni yarating:
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
JWT_ALGORITHM=RS256
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS (vergul bilan ajratilgan ishonchli domenlar) ---
# Bu yerga API'ga so'rov yuboradigan FRONTEND manzillari yoziladi (masalan admin paneli).
# Backend'ning o'zi (http://localhost:8000) va Swagger /docs same-origin — bu yerga yozilmaydi.
CORS_ORIGINS=http://localhost:3000

# --- Biznes logika ---
TIMEZONE=Asia/Tashkent
BATCHING_MIN_ORDERS_PER_GROUP=1

# --- Fayl saqlash (rasm) ---
# S3 sozlanmagan bo'lsa lokal saqlanadi (media_dir), /media orqali ko'rsatiladi.
MEDIA_DIR=media
# To'liq URL uchun (masalan http://164.90.210.222:8000). Bo'sh bo'lsa nisbiy "/media/..."
PUBLIC_BASE_URL=

# --- Integratsiyalar (ixtiyoriy, hozircha bo'sh) ---
# S3 (rasm yuklash) — kalit berilsa lokal o'rniga S3 ishlatiladi
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# SMS OTP provayderi
SMS_API_URL=
SMS_API_KEY=
# Telegram bot — SMS yo'q bo'lsa OTP shu bot orqali admin'larga yuboriladi
BOT_TOKEN=
OTP_NOTIFY_CHAT_IDS=961047307,1038185913
