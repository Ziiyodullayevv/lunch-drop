{
  "expo": {
    "name": "Lunch Drop",
    "slug": "lunchdrop",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lunchdrop",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "com.lunchdrop.mobile"
    },
    "android": {
      "package": "com.lunchdrop.mobile",
      "userInterfaceStyle": "light",
      "predictiveBackGestureEnabled": false,
      "permissions": ["android.permission.RECORD_AUDIO"]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "defaultChannel": "orders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Profil rasmini tanlash uchun galereyaga ruxsat bering."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/icon-splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFFFF",
            "image": "./assets/images/icon-splash.png"
          }
        }
      ]
    ],
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": false
    },
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9e27d06a-e1d1-49b4-a586-f646430fb105"
      }
    }
  }
}
